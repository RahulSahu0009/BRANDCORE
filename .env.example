# BRANDCORE — Environment variable names
# Copy this file to .env for local tooling that reads .env
# For Cloudflare Worker local dev, use .dev.vars instead (see .dev.vars.example)
# NEVER commit .env or .dev.vars with real values

# No frontend environment variables with secrets.
# Do not use VITE_ prefixed variables for secrets.
VITE_APP_NAME=BRANDCORE
